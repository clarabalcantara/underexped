<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

        <!-- Definir nome da unidade de persistência -->
    <persistence-unit name="nome-da-unidade-de-persistencia" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Declaração das classes -->
        <!-- example: <class>br.com.turmalina.model.ClasseEntidade</class> -->

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver" />
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/nome-do-banco" /> <!-- Endereço do banco (definir o nome do banco) -->
            <property name="jakarta.persistence.jdbc.user" value="nome-do-usuario"/>   <!-- Definir usuário no banco -->
            <property name="jakarta.persistence.jdbc.password" value="senha-do-banco"/>   <!-- Definir senha do banco -->
            <property name="hibernate.hbm2ddl.auto" value="update" />
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
        </properties>
    </persistence-unit>
</persistence>